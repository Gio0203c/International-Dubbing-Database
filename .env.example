# Copy this file to `.env` and fill in your local values.
# Never commit `.env` to Git.

# PostgreSQL connection settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=iddb
PGUSER=iddb_user
PGPASSWORD=change_me

# Polite User-Agent required by the Wikimedia Query Service (WDQS) policy.
# Replace the contact details with your own project URL or contact email.
WIKIDATA_USER_AGENT=InternationalDubbingDatabase/0.1 (https://github.com/Gio0203c/International-Dubbing-Database)
