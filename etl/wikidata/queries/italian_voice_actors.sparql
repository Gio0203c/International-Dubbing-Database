# Italian voice actors and dubbing crew pilot slice from Wikidata Query Service (WDQS).
#
# Scope anchors:
#   - wdt:P31 wd:Q5                          human
#   - wdt:P27 in (wd:Q38, wd:Q172579)        Italy or Kingdom of Italy
#   - wdt:P106/wdt:P279* in (Q2405480 voice actor, Q1298794 dub director,
#     Q1208493 voice director, Q3026032 dialogue writer)
#     OR wdt:P101 wd:Q187657 (field of work: dubbing)
#     OR wdt:P106 wd:Q187657 (dubbing)
#
# Aggregation:
#   Returns exactly one row per Wikidata entity (?person). Multi-valued
#   properties are concatenated with "|" and resolved deterministically in
#   etl/wikidata/transform.py to avoid Cartesian product row duplication.
#   Birth and death timestamps include wikibase:timePrecision as "<iso>@<precision>"
#   (11 = day, 10 = month, 9 = year) so year-only dates never become fake Jan 1 birthdays.

PREFIX hint: <http://www.bigdata.com/queryHints#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT
  ?person
  (COALESCE(SAMPLE(?labelIt), SAMPLE(?labelMul), SAMPLE(?labelEn)) AS ?displayName)
  (GROUP_CONCAT(DISTINCT STR(?familyName); SEPARATOR="|") AS ?familyNames)
  (GROUP_CONCAT(DISTINCT STR(?legalName); SEPARATOR="|") AS ?legalNames)
  (GROUP_CONCAT(DISTINCT STR(?birthDate); SEPARATOR="|") AS ?birthDates)
  (GROUP_CONCAT(DISTINCT STR(?deathDate); SEPARATOR="|") AS ?deathDates)
  (GROUP_CONCAT(DISTINCT STR(?gender); SEPARATOR="|") AS ?genderUris)
  (GROUP_CONCAT(DISTINCT STR(?nativeLangCode); SEPARATOR="|") AS ?nativeLangCodes)
  (GROUP_CONCAT(DISTINCT STR(?countryCode); SEPARATOR="|") AS ?countryCodes)
  (GROUP_CONCAT(DISTINCT STR(?imdbId); SEPARATOR="|") AS ?imdbIds)
  (GROUP_CONCAT(DISTINCT STR(?tmdbId); SEPARATOR="|") AS ?tmdbIds)
WHERE {
  {
    SELECT DISTINCT ?person WHERE {
      hint:SubQuery hint:runOnce true .
      {
        VALUES ?occ { wd:Q2405480 wd:Q11481802 wd:Q622807 wd:Q1298794 wd:Q1208493 wd:Q3026032 wd:Q187657 }
        VALUES ?country { wd:Q38 wd:Q172579 }
        ?person wdt:P106 ?occ ;
                wdt:P27 ?country ;
                wdt:P31 wd:Q5 .
      }
      UNION
      {
        VALUES ?country { wd:Q38 wd:Q172579 }
        ?person wdt:P101 wd:Q187657 ;
                wdt:P27 ?country ;
                wdt:P31 wd:Q5 .
      }
    }
  }

  OPTIONAL { ?person rdfs:label ?labelIt . FILTER(LANG(?labelIt) = "it") }
  OPTIONAL { ?person rdfs:label ?labelMul . FILTER(LANG(?labelMul) = "mul") }
  OPTIONAL { ?person rdfs:label ?labelEn . FILTER(LANG(?labelEn) = "en") }

  OPTIONAL {
    ?person wdt:P734 ?familyNameItem .
    ?familyNameItem rdfs:label ?familyName .
    FILTER(LANG(?familyName) IN ("it", "mul", "en"))
  }

  OPTIONAL { ?person wdt:P1477 ?legalName . }

  OPTIONAL {
    ?person p:P569 ?birthStmt .
    ?birthStmt a wikibase:BestRank ;
               psv:P569 ?birthVal .
    ?birthVal wikibase:timeValue ?birthTime ;
              wikibase:timePrecision ?birthPrecision .
    BIND(CONCAT(STR(?birthTime), "@", STR(?birthPrecision)) AS ?birthDate)
  }

  OPTIONAL {
    ?person p:P570 ?deathStmt .
    ?deathStmt a wikibase:BestRank ;
               psv:P570 ?deathVal .
    ?deathVal wikibase:timeValue ?deathTime ;
              wikibase:timePrecision ?deathPrecision .
    BIND(CONCAT(STR(?deathTime), "@", STR(?deathPrecision)) AS ?deathDate)
  }

  OPTIONAL { ?person wdt:P21 ?gender . }

  OPTIONAL {
    ?person wdt:P103 ?nativeLangItem .
    ?nativeLangItem wdt:P218 ?nativeLangCode .
  }

  OPTIONAL {
    ?person wdt:P27 ?countryItem .
    ?countryItem wdt:P297 ?countryCode .
  }

  OPTIONAL { ?person wdt:P345 ?imdbId . }
  OPTIONAL { ?person wdt:P4985 ?tmdbId . }
}
GROUP BY ?person
ORDER BY ?person
