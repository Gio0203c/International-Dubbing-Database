# Aliases and stage names for Italian voice actors from WDQS.
#
# Uses a Blazegraph named subquery (WITH ... AS %speakers) and explicit UNION
# branches across P742 (pseudonym) and skos:altLabel (it/en/mul).

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT
  ?person
  ?aliasType
  ?aliasName
WITH {
  SELECT DISTINCT ?person WHERE {
    {
      VALUES ?occ { wd:Q2405480 wd:Q11481802 wd:Q622807 wd:Q1298794 wd:Q1208493 wd:Q3026032 wd:Q187657 }
      VALUES ?country { wd:Q38 wd:Q172579 }
      ?person wdt:P106 ?occ ;
              wdt:P27 ?country ;
              wdt:P31 wd:Q5 .
    }
    UNION
    {
      VALUES ?country { wd:Q38 wd:Q172579 }
      ?person wdt:P101 wd:Q187657 ;
              wdt:P27 ?country ;
              wdt:P31 wd:Q5 .
    }
  }
} AS %speakers
WHERE {
  INCLUDE %speakers
  {
    ?person wdt:P742 ?aliasName .
    BIND("stage_name" AS ?aliasType)
  }
  UNION
  {
    ?person skos:altLabel ?aliasName .
    FILTER(LANG(?aliasName) IN ("it", "en", "mul"))
    BIND("other" AS ?aliasType)
  }
  FILTER(!isBlank(?aliasName))
}
ORDER BY ?person ?aliasType ?aliasName
