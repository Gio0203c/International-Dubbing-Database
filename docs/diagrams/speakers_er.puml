@startuml speakers_er
hide circle
skinparam linetype ortho

package "staging schema" {
  entity "staging.wikidata_raw" as wikidata_raw {
    * id : BIGINT <<PK, identity>>
    --
    run_id : BIGINT <<logical FK>>
    * wikidata_qid : TEXT
    * payload : JSONB
    * payload_hash : TEXT
    * fetched_at : TIMESTAMPTZ
  }
}

package "public schema" {
  entity "public.speakers" as speakers {
    * id : BIGINT <<PK, identity>>
    * public_id : TEXT <<UK, generated>>
    --
    * display_name : TEXT
    * sort_name : TEXT
    legal_name : TEXT
    birth_year : SMALLINT
    birth_month : SMALLINT
    birth_day : SMALLINT
    death_year : SMALLINT
    death_month : SMALLINT
    death_day : SMALLINT
    gender : TEXT
    native_lang : TEXT
    country_code : TEXT
    --
    wikidata_qid : TEXT <<UK>>
    imdb_nconst : TEXT <<UK>>
    tmdb_person_id : INTEGER <<UK>>
    --
    * primary_source : TEXT
    * is_verified : BOOLEAN
    last_seen_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }

  entity "public.speaker_relationships" as speaker_relationships {
    * id : BIGINT <<PK, identity>>
    --
    * speaker_id : BIGINT <<FK, UK>>
    * related_speaker_id : BIGINT <<FK, UK>>
    * relationship_type : TEXT <<UK>>
    is_ended : BOOLEAN
    start_year : SMALLINT
    end_year : SMALLINT
    --
    * source : TEXT
    * is_verified : BOOLEAN
    last_seen_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }

  entity "public.speaker_aliases" as speaker_aliases {
    * id : BIGINT <<PK, identity>>
    --
    * speaker_id : BIGINT <<FK, UK>>
    * alias_name : TEXT <<UK>>
    sort_name : TEXT
    * alias_type : TEXT
    locale : TEXT <<UK>>
    * is_primary : BOOLEAN
    --
    * source : TEXT
    * is_verified : BOOLEAN
    last_seen_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }

  entity "public.speaker_languages" as speaker_languages {
    * id : BIGINT <<PK, identity>>
    --
    * speaker_id : BIGINT <<FK, UK>>
    * lang_code : TEXT <<UK>>
    * role : TEXT <<UK>>
    --
    * source : TEXT
    * is_verified : BOOLEAN
    last_seen_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }

  entity "public.speaker_external_ids" as speaker_external_ids {
    * id : BIGINT <<PK, identity>>
    --
    * speaker_id : BIGINT <<FK>>
    * provider : TEXT <<UK>>
    * external_id : TEXT <<UK>>
    --
    * source : TEXT
    * is_verified : BOOLEAN
    last_seen_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }

  entity "public.etl_runs" as etl_runs {
    * id : BIGINT <<PK, identity>>
    --
    * source : TEXT
    * status : TEXT
    * started_at : TIMESTAMPTZ
    finished_at : TIMESTAMPTZ
    * rows_extracted : INTEGER
    * rows_inserted : INTEGER
    * rows_updated : INTEGER
    * rows_discarded : INTEGER
    error_message : TEXT
  }
}

speakers ||--o{ speaker_relationships : "speaker_id (subject)"
speakers ||--o{ speaker_relationships : "related_speaker_id (related)"
speakers ||--o{ speaker_aliases : "aliases"
speakers ||--o{ speaker_languages : "languages"
speakers ||--o{ speaker_external_ids : "external IDs"
etl_runs |o..o{ wikidata_raw : "logical run reference (no rigid FK)"
wikidata_raw ..> speakers : "transformed & upserted via wikidata_qid / bridge IDs"

note bottom of speaker_aliases
  <<UK>> marks functional index uq_speaker_aliases_speaker_name_locale
  (speaker_id, lower(btrim(alias_name)), COALESCE(locale, '')).
  Partial unique index uq_speaker_aliases_primary_per_locale enforces
  at most one is_primary = TRUE row per (speaker_id, COALESCE(locale, '')).
end note
@enduml
