[Unit]
Description=IDDb weekly Wikidata voice actors sync
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/path/to/International-Dubbing-Database
EnvironmentFile=/path/to/International-Dubbing-Database/.env
ExecStart=/path/to/International-Dubbing-Database/.venv/bin/python -m etl.run_wikidata_sync
Nice=10
